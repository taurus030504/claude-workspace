<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PersonalAIWiki.Desktop.Converters">

    <!-- App palette (dark). Standard controls are styled by WPF's built-in Fluent theme
         (Application.ThemeMode="Dark"); these brushes are for the app's own surfaces. -->
    <SolidColorBrush x:Key="Paw.Surface" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Paw.SurfaceAlt" Color="#232323" />
    <SolidColorBrush x:Key="Paw.Card" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Paw.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Paw.Text" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Paw.TextMuted" Color="#A6A6A6" />
    <SolidColorBrush x:Key="Paw.Accent" Color="#5CC8FF" />
    <SolidColorBrush x:Key="Paw.AccentSoft" Color="#1F3A4D" />
    <SolidColorBrush x:Key="Paw.Danger" Color="#FF7A7A" />
    <SolidColorBrush x:Key="Paw.DangerSoft" Color="#4A2323" />
    <SolidColorBrush x:Key="Paw.Success" Color="#7BD88F" />
    <SolidColorBrush x:Key="Paw.Warning" Color="#F5C451" />
    <SolidColorBrush x:Key="Paw.WarningSoft" Color="#453A1C" />
    <SolidColorBrush x:Key="Paw.CodeBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="Paw.UserBubble" Color="#243444" />
    <SolidColorBrush x:Key="Paw.AiBubble" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Paw.Highlight" Color="#5A4A12" />

    <FontFamily x:Key="Paw.UiFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Paw.MonoFont">Cascadia Mono, Consolas, D2Coding, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Paw.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
    <conv:NullToVisibilityConverter x:Key="NotNullToCollapsed" Invert="True" />
    <conv:EmptyToVisibilityConverter x:Key="EmptyToCollapsed" />
    <conv:EmptyToVisibilityConverter x:Key="NotEmptyToCollapsed" Invert="True" />
    <conv:LocalTimeConverter x:Key="LocalTime" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:InverseBoolConverter x:Key="InverseBool" />

    <Style x:Key="Paw.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Paw.Text}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Paw.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Paw.Text}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Paw.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Paw.TextMuted}" />
        <Setter Property="Margin" Value="4,12,4,6" />
    </Style>
    <Style x:Key="Paw.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Paw.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Paw.Error" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Paw.Danger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style x:Key="Paw.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Paw.IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Paw.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Paw.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Paw.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="Paw.Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Paw.SurfaceAlt}" />
    </Style>
    <Style x:Key="Paw.LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Paw.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
