{
  // Desktop app settings. The backend has its own settings (PAW_* environment variables).
  "Backend": {
    // Must match the backend's PAW_HOST / PAW_PORT.
    "BaseUrl": "http://127.0.0.1:8765/",
    // Start the Python backend automatically if it is not running.
    "AutoStart": true,
    // Empty = find the "backend" folder by walking up from this executable.
    "BackendDirectory": "",
    // Empty = <BackendDirectory>\.venv\Scripts\python.exe
    "PythonExecutable": "",
    // Empty = %LOCALAPPDATA%\PersonalAIWiki (or PAW_DATA_DIR). Must match the backend.
    "DataDir": "",
    "StartupTimeoutSeconds": 45
  }
}
