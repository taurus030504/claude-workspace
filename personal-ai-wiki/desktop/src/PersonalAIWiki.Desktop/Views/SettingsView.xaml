<UserControl x:Class="PersonalAIWiki.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="설정" Style="{StaticResource Paw.H1}" />
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Paw.Success}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding Message, Converter={StaticResource EmptyToCollapsed}}" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Paw.Error}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToCollapsed}}" />

            <!-- Local LLM -->
            <Border Style="{StaticResource Paw.Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="로컬 LLM (Ollama)" Style="{StaticResource Paw.H2}" />
                    <TextBlock Style="{StaticResource Paw.Muted}" Margin="0,0,0,8">
                        <Run Text="서버:" /> <Run Text="{Binding Llm.BaseUrl, Mode=OneWay}" />
                        <Run Text="  버전:" /> <Run Text="{Binding Llm.Version, Mode=OneWay, TargetNullValue='-'}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="연결 안 됨" />
                                <Setter Property="Foreground" Value="{StaticResource Paw.Warning}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Llm.Reachable}" Value="True">
                                        <Setter Property="Text" Value="Ollama 연결됨" />
                                        <Setter Property="Foreground" Value="{StaticResource Paw.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="사용할 모델" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding InstalledModels}"
                                  Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="설치된 모델을 고르거나 이름을 직접 입력 (예: gemma3:4b)" />
                        <Button Grid.Column="2" Content="다시 확인" Command="{Binding CheckLlmCommand}" Margin="8,0,0,0" Padding="10,4" />
                    </Grid>
                    <TextBlock Style="{StaticResource Paw.Muted}" FontSize="12" Margin="0,0,0,8"
                               Text="그래픽카드 없는 16GB PC 권장: gemma3:4b (기본), exaone3.5:2.4b (한국어 특화·가벼움), qwen2.5:3b. 7B 이상은 CPU에서 매우 느릴 수 있습니다." />

                    <Border Background="{StaticResource Paw.WarningSoft}" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                            Visibility="{Binding Guidance.Count, Converter={StaticResource EmptyToCollapsed}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Guidance}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Ollama 다운로드 페이지 열기" Command="{Binding OpenOllamaDownloadCommand}"
                                    HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Search sources -->
            <Border Style="{StaticResource Paw.Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="AI 답변에 사용할 자료" Style="{StaticResource Paw.H2}" />
                    <CheckBox Content="위키 문서 검색" IsChecked="{Binding SearchWiki}" Margin="0,2" />
                    <CheckBox Content="AI 메모리 검색 (Phase 1에서 적용)" IsChecked="{Binding SearchMemory}" IsEnabled="False" Margin="0,2" />
                    <CheckBox Content="프로젝트·작업 상태 검색 (Phase 2에서 적용)" IsChecked="{Binding SearchProjects}" IsEnabled="False" Margin="0,2" />
                    <CheckBox Content="과거 대화 기록 검색 (Phase 3에서 적용)" IsChecked="{Binding SearchConversations}" IsEnabled="False" Margin="0,2" />
                    <Button Content="설정 저장" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Padding="14,4" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource Paw.Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="데이터와 개인정보" Style="{StaticResource Paw.H2}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="모든 데이터는 이 PC에만 저장됩니다. 백엔드는 127.0.0.1에서만 접속을 받으며, 외부 네트워크 전송은 별도로 설정하지 않는 한 차단됩니다." />
                    <TextBlock Style="{StaticResource Paw.Muted}">
                        <Run Text="데이터 폴더:" /> <Run Text="{Binding Status.DataDir, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Paw.Muted}">
                        <Run Text="데이터베이스:" /> <Run Text="{Binding Status.DbPath, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Paw.Muted}">
                        <Run Text="스키마 버전:" /> <Run Text="{Binding Status.SchemaVersion, Mode=OneWay}" />
                        <Run Text="  검색 토크나이저:" /> <Run Text="{Binding Status.FtsTokenizer, Mode=OneWay}" />
                        <Run Text="  휴지통 문서:" /> <Run Text="{Binding Status.DeletedPageCount, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="데이터 폴더 열기" Command="{Binding OpenDataFolderCommand}" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="지금 백업" Command="{Binding BackupCommand}" Margin="0,0,6,0" Padding="10,4"
                                ToolTip="데이터베이스의 일관된 복사본을 backups 폴더에 만듭니다" />
                        <Button Content="검색 색인 다시 만들기" Command="{Binding ReindexCommand}" Padding="10,4"
                                ToolTip="문서 내용으로부터 검색 색인을 다시 생성합니다 (데이터는 변경되지 않음)" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Paw.Muted}" FontSize="12" Margin="0,8,0,0"
                               Text="백업 복원: 앱을 종료한 뒤 scripts\restore-backup.ps1 &lt;백업파일&gt; 을 실행하세요. 현재 DB는 삭제되지 않고 옆에 보관됩니다." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
