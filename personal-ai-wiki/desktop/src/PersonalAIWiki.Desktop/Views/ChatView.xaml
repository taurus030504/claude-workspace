<UserControl x:Class="PersonalAIWiki.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PersonalAIWiki.Core.Models;assembly=PersonalAIWiki.Core">
    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sessions -->
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="새 대화" Command="{Binding NewSessionCommand}" Padding="10,4" />
                <TextBlock Text="대화" Style="{StaticResource Paw.H2}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ChatSession}">
                        <DockPanel Margin="0,3">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Paw.LinkButton}" ToolTip="대화 삭제" Padding="6,0"
                                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Style="{StaticResource Paw.Icon}" Text="&#xE74D;" FontSize="12" Foreground="{StaticResource Paw.TextMuted}" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{StaticResource Paw.TextMuted}">
                                    <Run Text="{Binding UpdatedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" />
                                    <Run Text="{Binding MessageCount, StringFormat=' · 메시지 {0}', Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Conversation -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center" MaxWidth="520"
                                Visibility="{Binding Messages.Count, Converter={StaticResource NotEmptyToCollapsed}}">
                        <TextBlock Text="무엇이든 물어보세요" Style="{StaticResource Paw.H2}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Paw.Muted}" TextAlignment="Center"
                                   Text="'위키 검색'이 켜져 있으면 내 위키 문서에서 관련 내용을 찾아 근거로 답하고, 답변 아래에 출처를 보여줍니다. 모든 처리는 이 PC의 로컬 모델(Ollama)에서 이루어집니다." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatMessageTemplate}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Model problem (Ollama missing, model not pulled, ...) -->
            <Border Grid.Row="1" Background="{StaticResource Paw.WarningSoft}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                    Visibility="{Binding LlmProblem, Converter={StaticResource EmptyToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="설정에서 확인" Command="{Binding OpenSettingsCommand}" Padding="10,4" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LlmProblem}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <!-- Input -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="64" MaxHeight="200" VerticalScrollBarVisibility="Auto" Padding="8"
                         PreviewKeyDown="InputBox_PreviewKeyDown" VerticalContentAlignment="Top" />
                <DockPanel Grid.Row="1" Margin="0,6,0,0">
                    <CheckBox Content="위키 검색 사용" IsChecked="{Binding UseWiki}" VerticalAlignment="Center"
                              ToolTip="켜면 위키 문서에서 관련 내용을 찾아 답변 근거로 사용합니다" />
                    <TextBlock Text="  Enter 보내기 · Shift+Enter 줄바꿈" FontSize="11" Foreground="{StaticResource Paw.TextMuted}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="중지" Command="{Binding CancelCommand}" Margin="0,0,6,0" Padding="12,4"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="보내기" Command="{Binding SendCommand}" Padding="16,4" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
