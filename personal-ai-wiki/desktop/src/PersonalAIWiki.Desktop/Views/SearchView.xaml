<UserControl x:Class="PersonalAIWiki.Desktop.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PersonalAIWiki.Core.Models;assembly=PersonalAIWiki.Core"
             xmlns:controls="clr-namespace:PersonalAIWiki.Desktop.Controls">
    <DockPanel Margin="16,12">
        <TextBlock DockPanel.Dock="Top" Text="검색" Style="{StaticResource Paw.H1}" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="검색" Command="{Binding SearchAgainCommand}" Padding="14,4" Margin="8,0,0,0" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchAgainCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Paw.Muted}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Style="{StaticResource Paw.Error}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToCollapsed}}" />
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <ListBox ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SearchHit}">
                    <Button Style="{StaticResource Paw.LinkButton}" Padding="6,8" Foreground="{StaticResource Paw.Text}"
                            Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock FontSize="15">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Paw.Accent}" />
                                <Run Text="{Binding Heading, StringFormat='  › {0}', Mode=OneWay}" Foreground="{StaticResource Paw.TextMuted}" />
                            </TextBlock>
                            <TextBlock controls:Highlight.Hit="{Binding}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
