<UserControl x:Class="PersonalAIWiki.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PersonalAIWiki.Core.Models;assembly=PersonalAIWiki.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="새로 고침" Command="{Binding RefreshCommand}" Padding="10,4" VerticalAlignment="Top" />
                <TextBlock Text="대시보드" Style="{StaticResource Paw.H1}" />
            </DockPanel>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Paw.Error}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToCollapsed}}" />

            <!-- Counters -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Paw.Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="위키 문서" Style="{StaticResource Paw.Muted}" />
                        <TextBlock Text="{Binding Status.PageCount}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Paw.Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="AI 대화" Style="{StaticResource Paw.Muted}" />
                        <TextBlock Text="{Binding Status.ChatSessionCount}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Paw.Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="기록된 활동" Style="{StaticResource Paw.Muted}" />
                        <TextBlock Text="{Binding Status.TimelineEventCount}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Paw.Card}">
                    <StackPanel>
                        <TextBlock Text="로컬 LLM" Style="{StaticResource Paw.Muted}" />
                        <TextBlock Text="{Binding Llm.ConfiguredModel}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="사용 불가 — 설정 화면 참고" />
                                    <Setter Property="Foreground" Value="{StaticResource Paw.Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Llm.ModelAvailable}" Value="True">
                                            <Setter Property="Text" Value="사용 가능" />
                                            <Setter Property="Foreground" Value="{StaticResource Paw.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- LLM setup guidance when needed -->
            <Border Background="{StaticResource Paw.WarningSoft}" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                    Visibility="{Binding Llm.Guidance.Count, Converter={StaticResource EmptyToCollapsed}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="로컬 LLM 설정이 필요합니다" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Llm.Guidance}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Paw.Muted}" FontSize="12" Margin="0,6,0,0"
                               Text="위키 작성·검색은 LLM 없이도 모두 사용할 수 있습니다." />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Paw.Card}">
                    <StackPanel>
                        <TextBlock Text="최근 수정한 문서" Style="{StaticResource Paw.H2}" />
                        <TextBlock Text="아직 문서가 없습니다. 상단의 '새 문서'로 시작하세요." Style="{StaticResource Paw.Muted}"
                                   Visibility="{Binding RecentPages.Count, Converter={StaticResource NotEmptyToCollapsed}}" />
                        <ItemsControl ItemsSource="{Binding RecentPages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PageSummary}">
                                    <Button Style="{StaticResource Paw.LinkButton}" Padding="0,5" Foreground="{StaticResource Paw.Text}"
                                            Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource Paw.TextMuted}">
                                                <Run Text="{Binding UpdatedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" />
                                                <Run Text="{Binding Folder, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Paw.Card}">
                    <StackPanel>
                        <TextBlock Text="최근 활동" Style="{StaticResource Paw.H2}" />
                        <TextBlock Style="{StaticResource Paw.Muted}" FontSize="12" Margin="0,0,0,6"
                                   Text="문서 생성·수정·삭제가 자동으로 기록됩니다. 타임라인 화면은 Phase 4에서 제공됩니다." />
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TimelineEvent}">
                                    <Button Style="{StaticResource Paw.LinkButton}" Padding="0,4" Foreground="{StaticResource Paw.Text}"
                                            Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding OccurredAt, Converter={StaticResource LocalTime}, ConverterParameter='MM-dd HH:mm', Mode=OneWay}"
                                                 Foreground="{StaticResource Paw.TextMuted}" />
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
