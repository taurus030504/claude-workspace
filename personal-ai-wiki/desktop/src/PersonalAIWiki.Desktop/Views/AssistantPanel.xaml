<UserControl x:Class="PersonalAIWiki.Desktop.Views.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compact chat for the right panel. Same ChatViewModel type as the chat screen,
         but its own conversation. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,4,0,6">
            <Button DockPanel.Dock="Right" Command="{Binding NewSessionCommand}" Padding="8,2" ToolTip="새 대화 시작">
                <TextBlock Style="{StaticResource Paw.Icon}" Text="&#xE710;" FontSize="12" />
            </Button>
            <TextBlock Text="AI 어시스턴트" Style="{StaticResource Paw.H2}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Paw.Muted}" FontSize="12" Margin="0,8"
                           Visibility="{Binding Messages.Count, Converter={StaticResource NotEmptyToCollapsed}}"
                           Text="문서를 보면서 바로 질문하세요. 답변은 위키 문서를 근거로 하며, 출처를 누르면 해당 문서가 열립니다." />
                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatMessageTemplate}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Paw.WarningSoft}" CornerRadius="6" Padding="8" Margin="0,6,0,0"
                Visibility="{Binding LlmProblem, Converter={StaticResource EmptyToCollapsed}}">
            <StackPanel>
                <TextBlock Text="{Binding LlmProblem}" TextWrapping="Wrap" FontSize="12" />
                <Button Content="설정에서 확인" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Padding="8,2" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="56" MaxHeight="160" VerticalScrollBarVisibility="Auto" Padding="6" VerticalContentAlignment="Top"
                     PreviewKeyDown="InputBox_PreviewKeyDown" />
            <DockPanel Margin="0,6,0,0">
                <CheckBox Content="위키 검색" IsChecked="{Binding UseWiki}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="중지" Command="{Binding CancelCommand}" Margin="0,0,6,0" Padding="10,3"
                            Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="보내기" Command="{Binding SendCommand}" Padding="12,3" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
