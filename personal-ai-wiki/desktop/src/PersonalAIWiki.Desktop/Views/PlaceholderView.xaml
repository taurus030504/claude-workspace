<UserControl x:Class="PersonalAIWiki.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Honest placeholder for features of later phases: says what is not implemented yet. -->
    <StackPanel Margin="20,16" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Paw.H1}" />
        <Border Background="{StaticResource Paw.AccentSoft}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,12">
            <TextBlock Text="{Binding Phase}" Foreground="{StaticResource Paw.Accent}" FontWeight="SemiBold" />
        </Border>
        <TextBlock Text="아직 구현되지 않은 기능입니다." FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="예정된 기능" Style="{StaticResource Paw.H2}" />
        <ItemsControl ItemsSource="{Binding Planned}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='• {0}'}" Margin="0,2" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
